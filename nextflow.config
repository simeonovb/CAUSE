manifest {
    name            = 'cause-nf'
    description     = 'From GWAS trait to CRISPRi sgRNAs for its regulatory variants'
    author          = 'Boris Simeonov'
    mainScript      = 'main.nf'
    version         = '0.4.0'
    nextflowVersion = '>=24.10.0'
}

params {
    traits = null  // --traits "A,B"; if unset, the pipeline asks
    match  = null  // --match exact | contains; if unset, exact with --traits, otherwise the pipeline asks
    outdir = "results"

    // ATAC-seq peaks (BED) to overlap the SNPs with; must be on the same assembly as ld_build
    atac_peaks = null  // --atac_peaks "PM.bed,SN.bed"; if unset, the pipeline asks

    // sgRNA design (FlashFry). The genome matching ld_build is downloaded automatically.
    sgrna_enzyme          = null    // --sgrna_enzyme spcas9-ngg-20; if unset, the pipeline asks
    sgrna_per_peak        = null    // --sgrna_per_peak 4; if unset, the pipeline asks
    sgrna_rank            = "efficiency"  // or "uniqueness", which SpCas9 and SaCas9 can share
    sgrna_max_run         = 3       // longest run of one base allowed in a spacer; 3 rejects AAAA
    sgrna_max_1mm         = 0       // off-target sites with 1 mismatch a guide may have
    sgrna_max_2mm         = 0       // off-target sites with 2 mismatches a guide may have
    sgrna_min_hsu         = 50      // lowest MIT (Hsu 2013) specificity score; 0 turns it off
    sgrna_min_specificity = 0.0     // optional extra CFD specificity floor; 0 turns it off
    keep_genome           = null    // --keep_genome true|false; if unset, the pipeline asks
    progress              = true    // stream the genome download and index build, whose
                                    // progress the run's own step counter cannot show
    genome_dir            = "${launchDir}/genome_cache"
    genome_url_base       = "https://hgdownload.soe.ucsc.edu/goldenPath"
    flashfry_url          = "https://github.com/mckennalab/FlashFry/releases/download/2.0/FlashFry-assembly-2.00.jar"
    flashfry_memory       = "8g"

    // LD proxy lookup (LDlink); the token is read from: nextflow secrets set LDLINK_TOKEN <token>
    ld_pop        = null    // --ld_pop EUR or CEU,YRI; if unset, the pipeline asks
    ld_build      = null    // --ld_build grch37 | grch38 | grch38_high_coverage; if unset, the pipeline asks
    ld_r2_min     = null    // --ld_r2_min 0.8 keeps proxies with R2 at or above 0.8; if unset, the pipeline asks
    ld_window     = 500000  // base pairs searched either side of each SNP
    ld_chunk_size = 25      // SNPs per LDlink task
    ld_max_snps   = null    // only look up the first N SNPs, for test runs
}

// conda is the default; -profile docker runs every step in the images built
// from containers/Dockerfile instead
conda.enabled = true

profiles {
    conda {
        conda.enabled  = true
        docker.enabled = false
    }
    docker {
        conda.enabled  = false
        docker.enabled = true
        // run as the calling user, so outputs and the genome cache are not owned by root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}
