params {
    traits = null  // --traits "A,B"; if unset, the pipeline asks
    match  = null  // --match exact | contains; if unset, exact with --traits, otherwise the pipeline asks
    outdir = "results"

    // LD proxy lookup (LDlink); the token is read from: nextflow secrets set LDLINK_TOKEN <token>
    ld_pop        = null    // --ld_pop EUR or CEU,YRI; if unset, the pipeline asks
    ld_build      = null    // --ld_build grch37 | grch38 | grch38_high_coverage; if unset, the pipeline asks
    ld_r2_min     = null    // --ld_r2_min 0.8 keeps proxies with R2 at or above 0.8; if unset, the pipeline asks
    ld_window     = 500000  // base pairs searched either side of each SNP
    ld_chunk_size = 25      // SNPs per LDlink task
    ld_max_snps   = null    // only look up the first N SNPs, for test runs
}

conda.enabled = true
